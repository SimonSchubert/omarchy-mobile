#!/bin/bash
# Force the on-screen keyboard up or down. Bound to Super+I in hypr/mobile.lua.
#
# Mostly unnecessary: moarchy-keyboard raises itself whenever a text field takes
# focus and retracts when focus moves to something without one. What is left
# for this script is the awkward cases -- an app that never advertises a text
# field, or pushing the keyboard out of the way without moving focus, as with a
# hardware keyboard attached.
#
# moarchy's moarchy-toggle-keyboard, unchanged but for its name. It drives the
# keyboard over DBus rather than by signal: moarchy-keyboard owns sm.puri.OSK0,
# the interface Phosh defines, and exposes a readable `Visible` property, so the
# toggle can ask before it acts instead of guessing.

set -euo pipefail

osk() {
  local verb=$1
  shift
  busctl --user "$verb" sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 "$@"
}

if ! visible=$(osk get-property Visible 2>/dev/null); then
  echo "${0##*/}: no on-screen keyboard on the bus (is moarchy-keyboard running?)" >&2
  exit 1
fi

# `busctl get-property` prints the variant as e.g. `b true`.
if [[ $visible == *true* ]]; then
  osk call SetVisible b false
else
  osk call SetVisible b true
fi
