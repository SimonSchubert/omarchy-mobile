# Discord, as a web app. X.desktop beside this one explains both halves: why an
# entry upstream already ships is repeated here, and what StartupWMClass is for.
#
# The URL is upstream's, /channels/@me rather than the front page, so a launch
# lands in the app rather than on the marketing site. Icon is upstream's name
# too: the artwork is applications/icons/omarchy-discord.png, kept under a
# prefix of its own because a `discord` in some icon theme would otherwise
# shadow it.
[Desktop Entry]
Version=1.0
Name=Discord
Exec=omarchy-launch-webapp https://discord.com/channels/@me
Terminal=false
Type=Application
Icon=omarchy-discord
StartupNotify=true
StartupWMClass=org.gnome.Epiphany.WebApp_discord_com
# No X-Omarchy-Mobile-Bar-Color, and that is the site's answer rather than an
# omission: `omarchy-mobile-webapp-color https://discord.com/channels/@me`
# finds no theme-color meta and no manifest link on the app shell. The bar and
# the band stay in the theme's colours here, which is what every app that
# states nothing gets.
