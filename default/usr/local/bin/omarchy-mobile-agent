#!/bin/bash
# A coding agent as an app in the drawer, not only a row in Settings.
#
# Ported from moarchy's `moarchy-agent`, which exists because upstream reaches
# an agent two ways and neither puts it in an app grid: the Default Agent menu
# (SUPER+SPACE, a dmenu) and a keybinding. A phone has neither, so an installed
# agent was reachable only by walking Settings > Apps & defaults > Default apps
# > AI agent -- four taps to open the thing you use every day, and nothing in
# the drawer to say it is there at all. Typing "agent" into the drawer answered
# nothing, because the one row that matched is guarded and the guard said no.
#
# So there is a .desktop file. The drawer is upstream's apps provider over the
# XDG dirs, ~/.local/share/applications included, so an entry appearing there is
# an icon in the grid with no drawer change at all.
#
#   omarchy-mobile-agent list           print the agents this script knows
#   omarchy-mobile-agent shim  <name>   write ~/.local/bin/<name>, download nothing
#   omarchy-mobile-agent entry [name]   write the drawer tile, install nothing
#   omarchy-mobile-agent seed           shim all of them, and write the tile once
#   omarchy-mobile-agent open  <name>   shim, tile, then install and launch through
#                                       omarchy-default-agent
#
# `open` is what both the Settings row and the drawer tile run, and it is
# idempotent on purpose: the first tap installs, every tap after it launches,
# and the tile is rewritten either way so a hand-edited or half-written file
# heals itself.
#
# ---------------------------------------------------------------------------
# One tile, thirteen agents
# ---------------------------------------------------------------------------
# There is exactly one file, omarchy-mobile-agent.desktop, and it is REWRITTEN
# rather than added to: its Name, Icon and Exec carry whichever agent was picked
# last. The grid gains one tile at first boot and never gains another, and that
# tile is always the agent you actually use. moarchy learned this the expensive
# way -- an entry per agent meant the grid grew by one every time a different
# one was tried and never shrank -- and this port starts where that ended.
#
# The one path that goes behind it is `omarchy-default-agent <name>` run by
# hand, which changes the default without coming through here and leaves the
# tile naming the previous agent. `omarchy-mobile-agent entry` with no argument
# is the repair: it re-reads the default and rewrites the tile to match.
#
# ---------------------------------------------------------------------------
# The tile before anything is picked
# ---------------------------------------------------------------------------
# Omarchy writes no default agent, so a fresh phone has picked nothing, and the
# tile has nothing to name. With nothing picked the tile is a SETUP tile: it
# opens Settings > Apps & defaults > Default apps > AI agent, which is the page
# that lists all thirteen and installs any of them. The first tap chooses, and
# from then on the tile is that agent's and stays that way. Two states, one file.
#
# There is deliberately no fallback agent. Naming one arbitrarily tells a user
# who wants Claude that their phone came with the wrong agent, and gives them no
# hint the other twelve exist.
set -uo pipefail

APPS="$HOME/.local/share/applications"
ENTRY="$APPS/omarchy-mobile-agent.desktop"

# Upstream's own names, from omarchy-default-agent's case statement. Duplicated
# rather than parsed out of it: that script maps a name to a mise package and
# exits, so there is nothing to ask it for, and a label is not worth sourcing a
# script that ends in `exec`. vm-selftest.sh asserts this list against
# upstream's `omarchy:args=` line, against the rows in Pages.js and against the
# icons that ship, so the duplication is checked rather than trusted.
agent_name() {
  case "$1" in
    claude)       echo "Claude Code" ;;
    codex)        echo "Codex" ;;
    copilot)      echo "GitHub Copilot" ;;
    crush)        echo "Crush" ;;
    cursor-agent) echo "Cursor CLI" ;;
    gemini)       echo "Gemini" ;;
    grok)         echo "Grok" ;;
    hermes)       echo "Hermes" ;;
    muse)         echo "Muse Code" ;;
    omp)          echo "Oh My Pi" ;;
    openclaw)     echo "OpenClaw" ;;
    opencode)     echo "OpenCode" ;;
    pi)           echo "Pi" ;;
    *)            return 1 ;;
  esac
}

agents() {
  printf '%s\n' claude codex copilot crush cursor-agent gemini grok hermes \
                muse omp openclaw opencode pi
}

# What mise is asked for, which is the agent's own name for eight of the eleven
# that go through mise at all. omarchy-default-agent spells that
# `agent_package=${agent_package:-$agent}` and names the three exceptions; they
# are named here for the same reason the labels are.
#
# An empty answer means "not through mise" -- see write_shim.
agent_package() {
  case "$1" in
    hermes|openclaw) echo "" ;;
    grok) echo "npm:@xai-official/grok" ;;
    omp)  echo "github:can1357/oh-my-pi" ;;
    muse) echo "http:muse[url=https://api.meta.ai/muse-launcher.sh,bin=muse,version_list_url=https://api.meta.ai/muse-code/channels/muse-stable,version_json_path=.version]" ;;
    *)    echo "$1" ;;
  esac
}

# The agent that has been picked, or nothing at all. There is deliberately no
# fallback: a fresh phone answers empty here and gets the setup tile.
#
# An unreadable file or a name this script does not know answers empty too. The
# file holds one word written by omarchy-default-agent, and a tile named after
# whatever else ended up in it is worse than a tile that offers the picker.
current_agent() {
  local agent="" file="$HOME/.config/omarchy/defaults/agent"
  [[ -f $file ]] && read -r agent <"$file"
  agent_name "${agent:-}" >/dev/null 2>&1 && echo "$agent"
}

# The mise wrapper, which is five lines and no download.
#
# omarchy-mise-install writes a ~/.local/bin/<name> that runs
# `mise use -g <package>` on first invocation, so this costs no network and no
# disk until someone actually opens the agent. That is the whole reason all of
# them are written at first boot rather than the one: eleven wrappers is eleven
# small files, not eleven downloads.
#
# What it buys is that the agent's own name works. `claude` typed into the
# terminal installs and runs claude, `omarchy-cmd-present claude` is true, and
# upstream's keybinding launcher -- which refuses on `omarchy-cmd-missing
# "$agent"` before it ever reaches mise -- has something to find.
#
# Hermes and OpenClaw are the two this must not touch, and that is upstream's
# rule rather than a choice here. Each has an installer of its own
# (omarchy-install-hermes-cli, omarchy-install-openclaw-cli) that owns
# ~/.local/bin/<name>, writes its own marker line into it, and refuses to
# overwrite anything it did not write. A mise wrapper at that path is a foreign
# file to them, so seeding one would leave the real installer standing aside
# from a stub that installs the wrong thing. Hermes needs its interpreter
# pinned, which a bare `mise use` has nowhere to say; OpenClaw comes from a
# pacman package. omarchy-default-agent calls those installers directly, so
# both agents still install and launch from the Settings row and from the tile.
write_shim() {
  local agent=$1 package bin="$HOME/.local/bin/$1"

  package=$(agent_package "$agent")
  [[ -n $package ]] || return 0

  # No mise, no wrapper. The wrapper's whole body is `mise use -g <package>`,
  # so on an image without mise -- a `--session-only` build, or one from before
  # [pkg.mise-bin] landed -- writing it puts eleven names on PATH that answer
  # `mise: command not found`. That is worse than leaving them absent:
  # `omarchy-cmd-present claude` would start saying yes, and upstream's
  # keybinding launcher checks exactly that before it launches anything.
  #
  # Not fatal and not noisy. The same image hides the AI agent row on the same
  # condition (Pages.js, `when: omarchy-cmd-present mise`), so this is the
  # agreed answer there rather than a surprise, and the tile is still written.
  command -v mise >/dev/null 2>&1 || return 0

  # A file we did not write is left alone. omarchy-mise-install always
  # clobbers, and every wrapper it has ever written mentions mise on two of its
  # five lines, so "exists and never says mise" is a real binary somebody put
  # there by hand and this is not the place to remove it. Upstream's own
  # user_install() in omarchy-default-agent reads the same file the same way
  # and treats it as the user's install, so leaving it is also what makes that
  # check keep working.
  if [[ -e $bin ]] && ! grep -q mise "$bin" 2>/dev/null; then
    echo "omarchy-mobile-agent: leaving $bin alone, it is not a mise wrapper" >&2
    return 0
  fi

  omarchy-mise-install "$package" "$agent"
}

write_entry() {
  local agent=$1 label
  label=$(agent_name "$agent") || {
    echo "omarchy-mobile-agent: unknown agent '$agent'" >&2; return 1; }

  mkdir -p "$APPS"

  # A themed name unique to this project, not an absolute path, which is where
  # this port parts company with moarchy. moarchy writes
  # `Icon=/usr/share/moarchy/agents/<name>.svg` because AppLibrary.iconSource()
  # returns a file URL for anything starting with "/" and never consults the
  # icon theme -- and it needed that escape because no agent has an icon in
  # Adwaita, breeze or hicolor, which left its tile on `system-run`, a stock
  # glyph the grid already draws for Terminal and Foot.
  #
  # That reason stops applying the moment we ship the icons ourselves. This
  # project installs them into hicolor under a prefix nothing else uses, which
  # is what the three shell-screen entries next to this file already do and for
  # the reason omarchy-mobile-wifi.desktop gives: a name of our own cannot be
  # shadowed by some theme's monochrome panel glyph. So the lookup is ordinary
  # and the file path stays out of the .desktop.
  cat >"$ENTRY.tmp" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=$label
Comment=Coding agent in a terminal
Exec=omarchy-mobile-agent open $agent
Icon=omarchy-mobile-agent-$agent
Terminal=false
StartupNotify=true
Categories=Development;Utility;
Keywords=ai;agent;coding;llm;
X-Omarchy-Mobile-Agent=$agent
EOF
  finish_entry
}

# Everything both tiles do once their body is at $ENTRY.tmp.
#
# Terminal=false on a tile that opens a TUI is not an oversight: every path out
# of `open` ends in omarchy-launch-tui or
# omarchy-launch-floating-terminal-with-presentation, both of which open a
# terminal of their own. A Terminal=true entry would nest a second one around it.
finish_entry() {
  # Written to a temporary file and moved, because the drawer is watching this
  # directory: Quickshell's DesktopEntries reloads on the write, and a truncated
  # file is a tile that vanishes and comes back.
  mv -f "$ENTRY.tmp" "$ENTRY" || { rm -f "$ENTRY.tmp"; return 1; }
  chmod +x "$ENTRY"

  # What omarchy-refresh-applications ends with, for the same reason: the
  # mimeinfo cache in that directory is stale the moment a .desktop lands in it.
  # The drawer does not need it -- Quickshell's DesktopEntries watches the
  # directory and the tile updates within seconds -- but everything else that
  # resolves a handler does.
  update-desktop-database "$APPS" 2>/dev/null || true
}

# The tile with no agent behind it, which is what a fresh phone gets.
#
# Exec opens the picker rather than installing anything, and it is the same IPC
# the plugin entries use to raise a shell surface from a .desktop
# (`Exec=omarchy-shell wifi open`, and settings.md's own IPC surface).
#
# Keywords carries all thirteen agent names, so a new user who opens the drawer
# and types "claude" finds the screen that installs Claude. Before this there
# was nothing in the grid to find -- and nothing in the settings index either,
# because the row that would have matched is guarded on mise.
write_setup_entry() {
  mkdir -p "$APPS"
  cat >"$ENTRY.tmp" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=AI Agent
Comment=Choose and install a coding agent
Exec=omarchy-shell settings openAt apps.default.agent
Icon=omarchy-mobile-agent
Terminal=false
StartupNotify=true
Categories=Development;Utility;
Keywords=ai;agent;coding;llm;$(agents | tr '\n' ';')
X-Omarchy-Mobile-Agent=none
EOF
  finish_entry
}

# The tile as it should be right now: the chosen agent's, or the setup tile
# when nothing has been chosen.
write_current() {
  local chosen
  chosen=$(current_agent)
  if [[ -n $chosen ]]; then write_entry "$chosen"; else write_setup_entry; fi
}

case "${1:-}" in
  list)
    agents
    ;;
  shim)
    [[ -n ${2:-} ]] || { echo "usage: omarchy-mobile-agent shim <name>" >&2; exit 2; }
    agent_name "$2" >/dev/null || { echo "omarchy-mobile-agent: unknown agent '$2'" >&2; exit 1; }
    write_shim "$2"
    ;;
  entry)
    # No argument means "whatever the tile should say now": the chosen agent, or
    # the setup tile when nothing is chosen. It is both the first-boot path and
    # the repair path for a default set behind this script's back.
    if [[ -n ${2:-} ]]; then write_entry "$2"; else write_current; fi
    ;;
  seed)
    # First boot, from the omarchy-mobile-first-run user unit. Every agent that
    # goes through mise gets its wrapper, and the grid gets its one tile.
    #
    # A wrapper that cannot be written is reported and not fatal: it costs that
    # agent's name on PATH, and Settings > Apps > AI agent installs it either
    # way -- those rows run omarchy-default-agent, which asks mise directly.
    rc=0
    while read -r a; do
      write_shim "$a" || { echo "omarchy-mobile-agent: no wrapper for $a" >&2; rc=1; }
    done < <(agents)
    write_current || rc=1
    exit $rc
    ;;
  open)
    [[ -n ${2:-} ]] || { echo "usage: omarchy-mobile-agent open <name>" >&2; exit 2; }
    agent_name "$2" >/dev/null || { echo "omarchy-mobile-agent: unknown agent '$2'" >&2; exit 1; }
    # Neither of these is fatal: the point of the tap is to open the agent, and
    # an unwritable ~/.local costs an icon or a name on PATH, not a session.
    write_shim "$2"  || echo "omarchy-mobile-agent: could not write the wrapper" >&2
    write_entry "$2" || echo "omarchy-mobile-agent: could not write the drawer tile" >&2
    # omarchy-default-agent installs through mise (or through the agent's own
    # installer) when it has to, writes ~/.config/omarchy/defaults/agent, and
    # execs omarchy-agent. exec, so this script is not left holding a process
    # for the life of the session.
    exec omarchy-default-agent "$2"
    ;;
  *)
    echo "usage: omarchy-mobile-agent {list|shim|entry|seed|open} [name]" >&2
    exit 2
    ;;
esac
