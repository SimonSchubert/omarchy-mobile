# --- built here, from the AUR ---------------------------------------------
# Not in ALARM. vm/build-packages.sh builds it from its AUR PKGBUILD, pinned as
# [pkg.xdg-terminal-exec] in the manifest, into the local repo pacstrap reads
# ahead of ALARM's. Every terminal Omarchy opens goes through it, which is most
# of what Settings' bridged rows do.
xdg-terminal-exec

# --- moarchy's default apps -----------------------------------------------
# Notes (moarchy-keep) and the App Store (moarchy-store), built by
# vm/build-packages.sh from [pkg.moarchy-keep] and [pkg.moarchy-store-git] and
# found in the same local repo. Everything they depend on the image already
# installs.
#
# The store installs through pkexec, which cannot authenticate an account the
# image locks: default/usr/share/polkit-1/rules.d/49-moarchy-store.rules is what
# lets it. And what it installs has to verify, which is archlinuxarm-keyring in
# the session tier.
moarchy-keep
moarchy-store-git

# --- GNOME's phone apps ---------------------------------------------------
# Not upstream's: Omarchy is a desktop and leaves calendars, contacts and maps
# to a browser tab. A phone without them is missing what a phone is for, the
# reason [pkg.moarchy-keep] gives for Notes. All are libadwaita, so they reflow
# to the 360px panel, and all are in ALARM's aarch64 [extra].
#
# Each fills a gap rather than doubling a tile. chromium, nautilus, foot, imv
# and mpv stay upstream's handlers: Music is a library to browse rather than a
# player for one file, and claims no MimeType, so mpv still opens what it did.
# Geary is the mail client that upstream's aether would have been (omitted:
# x86_64-only). Camera is for the phone this image stands in for; the VM has no
# /dev/video, so there it stops at the portal's permission prompt.
#
# About 140 MB of download, against the 400 MB the six omitted packages cost.
# Most of it is two WebKits that evolution-data-server brings for Calendar and
# Contacts, and Geary uses webkit2gtk-4.1 too, so it costs only 3 MB more.
# Camera, Music and Sound Recorder share their GStreamer plugins: 13 MB for the
# three.
gnome-calculator
gnome-calendar
gnome-contacts
gnome-maps
gnome-clocks
gnome-weather
gnome-text-editor
geary
snapshot
gnome-music
gnome-sound-recorder
