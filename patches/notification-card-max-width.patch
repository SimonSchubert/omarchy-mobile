diff --git a/shell/plugins/notifications/Service.qml b/shell/plugins/notifications/Service.qml
index 0122310..4e95ad5 100644
--- a/shell/plugins/notifications/Service.qml
+++ b/shell/plugins/notifications/Service.qml
@@ -1041,6 +1041,11 @@ Item {
             NotificationCard {
               id: card
               anchors.right: parent.right
+              // The column is inset from both screen edges by the placement
+              // margins, so that is exactly the room a card has.
+              maxWidth: popupWindow.width
+                        - popupWindow.popupPlacement.margins.left
+                        - popupWindow.popupPlacement.margins.right
               app: cardSlot.app
               appIcon: cardSlot.appIcon
               summary: cardSlot.summary
diff --git a/shell/plugins/notifications/components/NotificationCard.qml b/shell/plugins/notifications/components/NotificationCard.qml
index 64e3870..1f83e4e 100644
--- a/shell/plugins/notifications/components/NotificationCard.qml
+++ b/shell/plugins/notifications/components/NotificationCard.qml
@@ -30,6 +30,13 @@ BorderSurface {
   // System monospace font injected by the container.
   property string fontFamily: ""
 
+  // Upper bound on the card's width, injected by the container. 0 leaves the
+  // card at its natural width. The container is what knows how much room there
+  // actually is — the popup column knows its own screen-edge margins, a panel
+  // would know its content width — so the limit comes from there rather than
+  // the card inferring it from the screen.
+  property real maxWidth: 0
+
   readonly property bool hovered: hoverTracker.hovered
 
   signal closeRequested()
@@ -63,7 +70,11 @@ BorderSurface {
     return Quickshell.iconPath(value, true)
   }
 
-  implicitWidth: Style.space(380)
+  // 380 is a comfortable desktop card. On a narrower screen it is wider than
+  // the screen itself, and because the popup column is anchored right the
+  // overflow lands on the left edge — taking the card's border and the first
+  // character of every line with it.
+  implicitWidth: maxWidth > 0 ? Math.min(Style.space(380), maxWidth) : Style.space(380)
   // Add vertical border insets so mainColumn (inset by border on top/left/right)
   // doesn't push content under the bottom edge.
   implicitHeight: mainColumn.implicitHeight + borderTop + borderBottom
